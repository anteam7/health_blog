# ── 관리자 ─────────────────────────────
ADMIN_EMAILS="you@example.com"

# ── Supabase ─
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROJECT_REF=""

# ── Cron 보호 (`openssl rand -hex 32` 결과로 교체) ─
CRON_SECRET=""

# ── AI ─
GEMINI_API_KEY=""
# ANTHROPIC_API_KEY=""

# ── 외부 API (선택) ─
NAVER_OPENAPI_CLIENT_ID=""
NAVER_OPENAPI_CLIENT_SECRET=""

# ── Site / Branding ─
# 정책 페이지의 canonical, sitemap, JSON-LD 의 기준이 되는 URL.
NEXT_PUBLIC_SITE_URL="https://healthscanner.co.kr"

# ── Analytics ─
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── AdSense (env-gated — 미설정 시 광고 스크립트·슬롯 모두 미렌더) ─
# AdSense Publisher ID. ca-pub-XXXXXXXXXXXXXXXX 형태. 승인 후 채움.
NEXT_PUBLIC_ADSENSE_CLIENT=""
# 본문 H2 두 번째 직전에 표시되는 In-article 슬롯 ID.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INLINE=""
# 본문 끝(ShareButtons 위)에 표시되는 In-article 슬롯 ID.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_FOOTER=""

# ── Kakao 공유 SDK (env-gated — 미설정 시 카카오 공유 버튼 미렌더) ─
# Kakao Developers (https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > JavaScript 키
# 사이트 도메인을 플랫폼 > Web 에 등록 필수.
NEXT_PUBLIC_KAKAO_APP_KEY=""

# ── Search Console 등 사이트 소유권 ─
# Google Search Console: https://search.google.com/search-console — HTML 메타 태그 모드 content 값.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Naver Search Advisor: https://searchadvisor.naver.com — 메타 태그 content 값.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""

# ── Unsplash (블로그 cover 이미지) ─
UNSPLASH_ACCESS_KEY=""
